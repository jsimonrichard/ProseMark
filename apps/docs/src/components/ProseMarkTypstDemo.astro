---
import ProseMarkDemoSharedStyles from './ProseMarkDemoSharedStyles.astro';
---

<div id="app">
  <div id="codemirror-container"></div>
</div>

<script>
  import { EditorView, keymap } from '@codemirror/view';
  import { markdown } from '@codemirror/lang-markdown';
  import { languages } from '@codemirror/language-data';
  import {
    prosemarkBasicSetup,
    prosemarkBaseThemeSetup,
    prosemarkMarkdownSyntaxExtensions,
    defaultClickLinkHandler,
  } from '@prosemark/core';
  import {
    htmlBlockExtension,
    renderHtmlMarkdownSyntaxExtensions,
  } from '@prosemark/render-html';
  import {
    typstMarkdownEditorExtensions,
    typstMarkdownSyntaxTheme,
  } from '@prosemark/typst';
  import {
    pasteRichTextExtension,
    pastePlainTextExtension,
  } from '@prosemark/paste-rich-text';
  import { GFM } from '@lezer/markdown';
  import { syntaxTree } from '@codemirror/language';
  import { printTree } from '@lezer-unofficial/printer';

  import initDoc from './typstInitDoc.md?raw';
  import { createSpellcheckExtensions } from './spellcheck';

  const editor = new EditorView({
    extensions: [
      markdown({
        codeLanguages: languages,
        extensions: [
          GFM,
          prosemarkMarkdownSyntaxExtensions,
          renderHtmlMarkdownSyntaxExtensions,
        ],
      }),
      prosemarkBasicSetup(),
      prosemarkBaseThemeSetup(),
      ...typstMarkdownSyntaxTheme,
      ...typstMarkdownEditorExtensions(),
      defaultClickLinkHandler,
      htmlBlockExtension,
      pasteRichTextExtension(),
      pastePlainTextExtension(),
      ...createSpellcheckExtensions(),
      keymap.of([
        {
          key: 'Alt-p',
          run: (view) => {
            console.log(
              printTree(syntaxTree(view.state), view.state.doc.toString()),
            );
            return true;
          },
        },
      ]),
    ],
    doc: initDoc,
    parent: document.getElementById('codemirror-container')!,
  });
</script>

<ProseMarkDemoSharedStyles />
